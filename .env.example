# Credenciales de integraciones — NO subir a git.
# Copia este archivo a ".env" y rellena tus claves:  cp .env.example .env
#
# HeyGen — obtén tu API key en: https://app.heygen.com  →  Settings → API
# (la escribes TÚ aquí; el asistente nunca la ve ni la pide por chat)
HEYGEN_API_KEY=

# Avatar y voz por defecto de HeyGen (opcionales: si no, pásalos con --avatar/--voz).
# Lístalos con:  python3 manuales/edicion-video/scripts/heygen.py avatares
#                python3 manuales/edicion-video/scripts/heygen.py voces --idioma Spanish
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# xAI (Grok Imagine) — b-roll e imágenes. Clave en: https://console.x.ai
# Empieza por 'xai-'. NO es la de Groq (gsk_) ni la de RunAPI.
XAI_API_KEY=

# Pexels — B-ROLL DE ARCHIVO (fotos y vídeo reales, gratis y de uso comercial).
# Clave instantánea y gratuita en: https://www.pexels.com/api/
#   python3 manuales/edicion-video/scripts/bancos.py buscar --proyecto 006 --consulta "grieta en la pared"
# Hermano de XAI_API_KEY y no su sustituto: Grok GENERA un plano que no existe,
# esto TRAE uno que sí existe. En una pieza periodística, un lugar o un hecho
# real se trae — generarlo es fabricar prueba documental.
# Límite por defecto: 200 peticiones/hora, 20.000/mes (ampliable gratis).
PEXELS_API_KEY=

# ElevenLabs — VOZ EN OFF (texto → audio). Clave en: https://elevenlabs.io
#   perfil (abajo a la izquierda) → API Keys → Create API Key
# Es el motor de voz del formato `video-noticias`: devuelve audio directo, sin
# renderizar un avatar que luego se tira. Se factura por CARACTERES.
ELEVENLABS_API_KEY=
# Voz por defecto (opcional). Lístalas con:
#   python3 manuales/edicion-video/scripts/elevenlabs.py voces
# (las marcadas «TUYA» son tus voces clonadas)
ELEVENLABS_VOICE_ID=
