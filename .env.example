# Credenciales de integraciones — NO subir a git.
# Copia este archivo a ".env" y rellena tus claves:  cp .env.example .env
#
# HeyGen — obtén tu API key en: https://app.heygen.com  →  Settings → API
# (la escribes TÚ aquí; el asistente nunca la ve ni la pide por chat)
HEYGEN_API_KEY=

# xAI (Grok Imagine) — b-roll e imágenes. Clave en: https://console.x.ai
# Empieza por 'xai-'. NO es la de Groq (gsk_) ni la de RunAPI.
XAI_API_KEY=

# ElevenLabs — VOZ EN OFF (texto → audio). Clave en: https://elevenlabs.io
#   perfil (abajo a la izquierda) → API Keys → Create API Key
# Es el motor de voz del formato `video-noticias`: devuelve audio directo, sin
# renderizar un avatar que luego se tira. Se factura por CARACTERES.
ELEVENLABS_API_KEY=
# Voz por defecto (opcional). Lístalas con:
#   python3 manuales/edicion-video/scripts/elevenlabs.py voces
# (las marcadas «TUYA» son tus voces clonadas)
ELEVENLABS_VOICE_ID=
